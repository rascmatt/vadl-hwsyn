# read design
read_verilog -sv rtl/decode_table_generated.sv

# elaborate design hierarchy
hierarchy -check -top DECODE

# the high-level stuff
proc; opt; fsm; opt; memory; opt

# mapping to internal cell library
techmap; opt

# mapping flip-flops to sky130_fd_sc_hd__tt_025C_1v80.lib
dfflibmap -liberty lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# mapping logic to sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# print stats
stat -liberty lib/sky130_fd_sc_hd__tt_025C_1v80.lib

# cleanup
clean

# write synthesized design
write_verilog build/decode_table_generated.v
